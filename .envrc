dotenv .local/elt.env

export PYTHONPATH="."
# `.local/elt.env` uses a path relative to the repo root (it's shared with
# docker-compose, where the working dir is /app). Resolve it against this
# file's directory so tools run from subdirectories (e.g. dbt in src/analytics)
# can still find the key file
export GOOGLE_APPLICATION_CREDENTIALS="$(expand_path "$GOOGLE_APPLICATION_CREDENTIALS")"
